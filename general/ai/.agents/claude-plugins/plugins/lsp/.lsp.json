{
  "taplo": {
    "command": "taplo",
    "args": [
      "lsp",
      "--no-auto-config",
      "stdio"
    ],
    "settings": {
      "evenBetterToml": {
        "taplo": {
          "configFile": {
            "enabled": true
          }
        }
      }
    },
    "extensionToLanguage": {
      ".toml": "toml"
    }
  },
  "yaml": {
    "command": "yaml-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".yaml": "yaml",
      ".yml": "yaml"
    }
  },
  "json": {
    "command": "vscode-json-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".json": "json",
      ".jsonc": "jsonc"
    }
  },
  "bash": {
    "command": "bash-language-server",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".sh": "shellscript",
      ".bash": "shellscript"
    }
  },
  "css": {
    "command": "vscode-css-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".css": "css",
      ".scss": "scss",
      ".less": "less"
    }
  },
  "fish": {
    "command": "fish-lsp",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".fish": "fish"
    }
  },
  "vale": {
    "command": "vale-ls",
    "env": {
      "VALE_CONFIG_PATH": "${HOME}/.agents/vale/.vale.ini"
    },
    "extensionToLanguage": {
      ".md": "markdown"
    }
  }
}
