{
  "taplo": {
    "command": "taplo",
    "args": [
      "lsp",
      "--no-auto-config",
      "stdio"
    ],
    "settings": {
      "evenBetterToml": {
        "taplo": {
          "configFile": {
            "enabled": true
          }
        }
      }
    },
    "extensionToLanguage": {
      ".toml": "toml"
    }
  },
  "yaml": {
    "command": "yaml-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".yaml": "yaml",
      ".yml": "yaml"
    }
  },
  "json": {
    "command": "vscode-json-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".json": "json",
      ".jsonc": "jsonc"
    }
  },
  "bash": {
    "command": "bash-language-server",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".sh": "shellscript",
      ".bash": "shellscript"
    }
  },
  "css": {
    "command": "vscode-css-language-server",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".css": "css",
      ".scss": "scss",
      ".less": "less"
    }
  },
  "fish": {
    "command": "fish-lsp",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".fish": "fish"
    }
  },
  "typescript": {
    "command": "vtsls",
    "args": [
      "--stdio"
    ],
    "settings": {
      "vtsls": {
        "autoUseWorkspaceTsdk": true
      }
    },
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  },
  "python": {
    "command": "ruff",
    "args": [
      "server"
    ],
    "initializationOptions": {
      "settings": {
        "lint": {
          "extendSelect": ["ANN", "B", "BLE", "ASYNC", "PGH", "RUF"],
          "ignore": ["B008", "RUF005", "RUF010", "RUF021", "RUF022", "RUF023"]
        }
      }
    },
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  }
}
