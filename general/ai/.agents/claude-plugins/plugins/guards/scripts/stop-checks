#!/usr/bin/env bash
input=$(cat)
active=$(jq -r '.stop_hook_active' <<<"$input")
id=$(jq -r '.session_id' <<<"$input")
cwd=$(jq -r '.cwd' <<<"$input")
[ "$active" = true ] && exit 0
marker="${TMPDIR:-/tmp}/claude-guards/$id"
[ -f "$marker" ] || exit 0
root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
changed=$(git diff --name-only HEAD 2>/dev/null) || exit 0
untracked=$(git ls-files --others --exclude-standard) || exit 0

diff=$(mktemp)
sarif=$(mktemp)
trap 'rm -f "$diff" "$sarif"' EXIT
files=()
while IFS= read -r f; do
  [ -f "$f" ] && [ "$f" -nt "$marker" ] || continue
  files+=("$f")
  git diff HEAD -- "$f" >>"$diff"
done <<<"$changed"
while IFS= read -r f; do
  [ -n "$f" ] && [ "$f" -nt "$marker" ] || continue
  files+=("$f")
  git diff --no-index /dev/null "$f" >>"$diff"
done <<<"$untracked"
[ ${#files[@]} -eq 0 ] && exit 0

HK_FILE="$HOME/.agents/hk/hk.pkl" hk run agent-checks --silent --no-fail-fast --no-stage --sarif "$sarif" "${files[@]}" >/dev/null 2>&1
out=$(reviewdog -f sarif -diff "cat $diff" -fail-level any <"$sarif" 2>&1) && exit 0
printf '%s\n\nagent-checks found problems in lines you changed this session. Fix them without suppression comments. If a rule does not fit this repo, change it in the repo lint config and say why. If something is outside your task, list it in your reply and ask.\n' "$out" >&2
exit 2
