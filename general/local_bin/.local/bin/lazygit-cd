#!/usr/bin/env bash

tmp=$(mktemp -t lazygit-cd.XXXXXX) || exit 1
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
title="lazygit: ${root##*/}"
[ -n "$YAZI_ID" ] && title="Yazi → $title"
printf '\033]2;%s\007' "$title" >/dev/tty 2>/dev/null

LAZYGIT_NEW_DIR_FILE="$tmp" command lazygit "$@"
code=$?

dir=$(cat -- "$tmp" 2>/dev/null)
[ -d "$dir" ] && [ "$dir" != "$PWD" ] || exit $code

if [ -n "$YAZI_ID" ]; then
    ya emit cd "$dir"
else
    printf '%s\n' "$dir"
fi
exit $code
