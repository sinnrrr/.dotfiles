#!/usr/bin/env bash
[ -n "$WEZTERM_PANE" ] || exit 0

title=""
if jq -e '.agent_id as $self | .hook_event_name == "SubagentStart" or any(.background_tasks[]?; .type == "subagent" and .status == "running" and .id != $self)' >/dev/null 2>&1; then
	title="claude-busy"
fi

wezterm cli set-tab-title --pane-id "$WEZTERM_PANE" "$title"
