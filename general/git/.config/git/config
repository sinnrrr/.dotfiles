[include]
	path = ~/.config/git/.gitconfig.personal

[include]
	path = ~/.config/git/.gitconfig.default

[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.config/git/.gitconfig.personal

[includeIf "gitdir:~/.dotfiles/work/"]
	path = ~/.config/git/.gitconfig.work

[includeIf "gitdir:/opt/homebrew/"]
	path = ~/.config/git/.gitconfig.work

[core]
	ignorecase = false
	pager = delta
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[delta]
	syntax-theme = "Catppuccin Mocha"
	tabs = 2
[merge]
	conflictStyle = diff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -p %P -l %L
[rebase]
	autoStash = true
	committerDateIsAuthorDate = true
	updateRefs = true
[init]
	defaultBranch = main
[spice "experiment"]
	commitFixup = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
